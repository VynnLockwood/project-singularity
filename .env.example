# Copy to .env and fill in. Never commit .env.
# Required. Generate: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=localhost
# Public origin(s) when served from a real host, e.g. https://singularity.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=

POSTGRES_DB=singularity
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
DB_APP_PASSWORD=change-me
DB_MASTER_RW_PASSWORD=change-me
DB_MASTER_RO_PASSWORD=change-me

GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Used from Milestone 3
OPENROUTER_API_KEY=
